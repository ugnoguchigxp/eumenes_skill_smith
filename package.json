{
	"name": "eumenes-skill-smith",
	"version": "0.1.0",
	"license": "MIT",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"packageManager": "bun@1.4.4",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./sqlite": {
			"types": "./dist/sqlite/index.d.ts",
			"import": "./dist/sqlite/index.js"
		}
	},
	"scripts": {
		"typecheck": "bun check",
		"lint": "oxlint --deny-warnings",
		"format": "bun fmt",
		"format:check": "bun fmt --check",
		"test": "bun test src/test",
		"test:examples": "bun test examples/contextstill/test",
		"context:snapshot": "python3 examples/contextstill/snapshot.py",
		"context:seed": "bun examples/contextstill/seed.ts",
		"context:seed:export": "bun examples/contextstill/export-seed.ts",
		"context:check": "bun examples/contextstill/check.ts",
		"context:task": "bun examples/contextstill/task.ts",
		"build": "bun scripts/build.ts",
		"pack:core": "bun scripts/pack.ts",
		"verify": "bun scripts/verify.ts",
		"context:eval": "bun examples/contextstill/eval-kit.ts",
		"context:eval-scenarios": "bun examples/contextstill/scenario-eval.ts",
		"context:scoreboard": "bun examples/contextstill/scoreboard.ts"
	},
	"dependencies": {
		"mdast-util-from-markdown": "2.0.2",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"@types/node": "25.9.3",
		"typescript": "7.0.2",
		"oxlint": "1.86.0"
	}
}
